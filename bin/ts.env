# Settings for technosophia's shared scripts (`ts`) and Roxana's own. Roxana
# is served by Amplify Hosting rather than from a box, so there is no HOST
# and the shared `ts deploy` and `ts deploys` do not apply: Roxana's are
# `ts amplify-deploy` and `ts amplify-jobs`. `ts health` is the shared one,
# reading the stamp amplify.yml writes.
URL=https://roxana.twohands.co
HEALTH_PATH=/deployed.json
AMPLIFY_APP_ID=d1gtwcafz2d83t
AMPLIFY_BRANCH=master
AMPLIFY_PROFILE=amplify
AMPLIFY_REGION=us-west-2
